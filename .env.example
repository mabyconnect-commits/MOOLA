# ── Moola backend environment variables ──────────────────────────────────────
# Copy to .env.local for local `vercel dev`, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Postgres connection string. Provisioned automatically when you add a
# Postgres/Neon store to the project in the Vercel dashboard (Storage tab).
# The @vercel/postgres client reads POSTGRES_URL.
POSTGRES_URL=

# Secret used to sign session tokens (JWT). Use a long random string.
# Generate one with:  openssl rand -base64 48
# REQUIRED in production — without a stable value, sessions break on redeploy.
JWT_SECRET=

# ── Email (optional) ─────────────────────────────────────────────────────────
# If RESEND_API_KEY is unset, verification still works: the API returns the
# 6-digit code and the signup screen shows it. Add a key to send real emails.
RESEND_API_KEY=
# The "from" address for verification emails. Must be a verified Resend sender
# / domain. Defaults to Resend's shared onboarding@resend.dev for quick testing.
MOOLA_EMAIL_FROM=Moola <onboarding@resend.dev>

# ── Solana deposits & withdrawals ────────────────────────────────────────────
# Helius (or any) RPC. Use a DEVNET url while testing, mainnet only when ready.
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# 24-word mnemonic that derives every per-user deposit address. SECRET — keep it
# only in Vercel env and backed up offline. Never commit it.
MASTER_SEED=twenty four word mnemonic ...

# Public treasury address that swept deposits land in (safe, non-secret).
TREASURY_ADDRESS=Cp3Ww6GRSMAg7VLkV7DcBg8oZDURe8VvR5LTRhH1UCCu

# Treasury hot-wallet PRIVATE KEY (base58). SECRET — signs sweeps as fee payer
# and receives the treasury share. On mainnet, use a dedicated hot wallet
# holding only operational float, not the whole treasury.
TREASURY_SECRET=

# Dedicated PAYOUT wallet — withdrawals are paid from here (kept separate from
# the treasury). PAYOUT_ADDRESS is public; PAYOUT_SECRET (base58) is SECRET and
# signs withdrawals. Fund this wallet with SOL for gas + payout float.
PAYOUT_ADDRESS=
PAYOUT_SECRET=

# Sweep split: percent of every swept deposit that goes to the PAYOUT wallet;
# the rest goes to the treasury. Default 45 (=> 45% payout / 55% treasury).
# SWEEP_PAYOUT_PCT=45

# Stablecoin mints. On DEVNET set these to your test mints (e.g. devnet USDC).
# Defaults are Solana MAINNET USDC/USDT.
# USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU   # devnet USDC example
# USDT_MINT=

# ── Withdrawal anti-abuse guard ──────────────────────────────────────────────
# Admin emails (comma-separated) that can open the /admin dashboard.
# ADMIN_EMAILS=you@example.com

# Master switch for the withdrawal guard. Default ON. It caps every withdrawal
# at the user's REAL earned value (own deposits + commission from referrals who
# actually deposited + staking rewards on their own stake) so free airdrop /
# bonus tokens can't be cashed out. Set to `off` only in an emergency.
# WITHDRAW_GUARD=on

# Rolling withdrawal window (hours). Only accounts YOUNGER than this may
# withdraw — someone who registered in the last 24h can cash out, older accounts
# (where the abuse sits) are frozen. Default 24. Set 0 (or `off`) to disable.
# WITHDRAW_MAX_ACCOUNT_AGE_HOURS=24

# Optional FIXED-cutoff override: freeze every account created before this ISO
# date instead of using the rolling window above. `off` disables freezing
# entirely. Leave UNSET to use the rolling 24h window.
# WITHDRAW_FREEZE_BEFORE=
